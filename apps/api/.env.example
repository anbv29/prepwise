NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=interview_prep

SESSION_TTL_DAYS=7
SESSION_COOKIE_NAME=prep_session

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
LLM_PROVIDER=openai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=2

# Optional fallback for OpenAI mode. Gemini mode uses Google Search grounding with GEMINI_API_KEY.
BRAVE_SEARCH_API_KEY=
SEARCH_REQUEST_TIMEOUT_MS=10000

WORKER_POLL_INTERVAL_MS=1000
WORKER_STALE_AFTER_MS=900000
WORKER_MAX_ATTEMPTS=3

RESEARCH_MAX_PAGES=5
RESEARCH_MAX_REDIRECTS=3
RESEARCH_MAX_RESPONSE_BYTES=1000000
RESEARCH_MAX_TEXT_CHARS=25000
RESEARCH_REQUEST_TIMEOUT_MS=10000
RESEARCH_CACHE_TTL_MS=86400000
RESEARCH_FAILURE_CACHE_TTL_MS=300000

# Local MongoDB and localhost fixtures require this locally. Omit it or set false on Vercel.
ALLOW_PRIVATE_NETWORKS=true
